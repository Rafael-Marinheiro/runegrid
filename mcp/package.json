{
  "name": "runegrid-mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server: an LLM runs a complete D&D 5e game on the RuneGrid rules engine, journaling everything to an Obsidian vault.",
  "main": "dist/index.js",
  "bin": {
    "runegrid-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
}
